# 团队模式 Compose 的环境变量示例：复制为 .env 后按实际环境修改。
# 容器访问宿主机上的 PostgreSQL 用 host.docker.internal；
# Linux 宿主机还需要在 docker-compose.team.yml 的 api 服务加
#   extra_hosts: ["host.docker.internal:host-gateway"]
WEB_PORT=3000
# 换成实际的数据库地址、用户和密码；密码含 @ : / 等字符时要 URL 编码。
DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/infinite_canvas
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
REGISTRATION_MODE=open
AUTO_VERIFY_EMAIL=true
FILE_URL_SECRET=change-me
# 必填：渠道 API Key 的加密密钥，换成随机长字符串
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string
