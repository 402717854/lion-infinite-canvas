# 服务端口
PORT=8787

# Postgres 连接串（开发库）
DATABASE_URL=postgres://postgres@127.0.0.1:55432/infinite_canvas

# 前端来源（CORS 白名单，逗号分隔）
APP_ORIGIN=http://127.0.0.1:3000

# 生产环境请置 true（HTTPS Cookie）
SESSION_COOKIE_SECURE=false

# 注册开关：open | invite | closed
REGISTRATION_MODE=open

# 开发默认自动验证邮箱；false 时注册接口返回 verificationToken
AUTO_VERIFY_EMAIL=true

# 素材/文件落盘目录（相对 canvas-api）
DATA_DIR=data/uploads

# 签名文件 URL 的 HMAC 密钥（生产务必替换）
FILE_URL_SECRET=canvas-dev-secret-change-me

# 签名文件 URL 有效期（秒）
FILE_URL_TTL_SECONDS=3600
