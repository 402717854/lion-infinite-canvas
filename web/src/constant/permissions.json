{
    "version": 1,
    "roles": [
        { "key": "owner", "name": "所有者", "description": "空间创建者，拥有全部权限，不可被降级或移除" },
        { "key": "admin", "name": "管理员", "description": "管理成员、角色、模型与空间设置，不能解散空间或转让所有权" },
        { "key": "editor", "name": "编辑者", "description": "创建与编辑项目、素材，可使用已授权模型" },
        { "key": "viewer", "name": "查看者", "description": "只读浏览空间内项目与素材" },
        { "key": "guest", "name": "访客", "description": "仅能查看被分享的项目与素材" }
    ],
    "permissions": [
        { "group": "空间", "key": "workspace.read", "label": "查看空间与基本信息" },
        { "group": "空间", "key": "workspace.update", "label": "改名、改描述、头像" },
        { "group": "空间", "key": "workspace.delete", "label": "解散空间" },
        { "group": "空间", "key": "workspace.settings.manage", "label": "安全策略、成员上限、默认模型" },
        { "group": "空间", "key": "workspace.ownership.transfer", "label": "转让所有者" },
        { "group": "成员", "key": "member.read", "label": "查看成员列表" },
